{{- $res := includeTemplate "screen-resolution" . | trim | splitList "x" -}}
{{- $gpu := includeTemplate "gpu-vendor" . | trim -}}
[General]
Name=REC_SCREEN

[Output]
Mode=Advanced
FilenameFormatting=%CCYY-%MM-%DD %hh-%mm-%ss
DelayEnable=false
Reconnect=true
RetryDelay=2
MaxRetries=25
BindIP=default
IPFamily=IPv4+IPv6
NewSocketLoopEnable=false
LowLatencyEnable=false

[AdvOut]
ApplyServiceSettings=true
UseRescale=false
TrackIndex=1
VodTrackIndex=2
Encoder=obs_x264
RecType=Standard
RecFilePath={{ .chezmoi.homeDir }}/Videos/obs
RecFormat2=mkv
RecUseRescale=false
RecTracks=3
RecEncoder={{ if eq $gpu "nvidia" }}obs_nvenc_hevc_tex{{ else }}hevc_ffmpeg_vaapi_tex{{ end }}
RecAudioEncoder=ffmpeg_pcm_s16le
AudioEncoder=ffmpeg_aac
Track1Bitrate=320
Track2Bitrate=320
RecSplitFile=false
RecRB=false
RecFileNameWithoutSpace=true

[Video]
BaseCX={{ index $res 0 }}
BaseCY={{ index $res 1 }}
OutputCX={{ index $res 0 }}
OutputCY={{ index $res 1 }}
FPSType=0
FPSCommon=30
ScaleType=bicubic
ColorFormat=NV12
ColorSpace=709
ColorRange=Partial
AutoRemux=true

[Audio]
MonitoringDeviceId=default
MonitoringDeviceName=По умолчанию
SampleRate=48000
ChannelSetup=Stereo
MeterDecayRate=23.53
PeakMeterType=0

[Hotkeys]
OBSBasic.StartRecording={"bindings":[]}
OBSBasic.StopRecording={"bindings":[]}
